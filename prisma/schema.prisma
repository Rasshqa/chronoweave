// ponytail: Standard Prisma schema for ChronoWeave Community Archive Gallery.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ArtworkArchive {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  creatorName    String   @default("Anonymous Architect")
  cityName       String
  country        String
  latitude       Float
  longitude      Float
  targetDate     String   // YYYY-MM-DD
  tempMax        Float
  tempMin        Float
  windSpeed      Float
  windDirection  Int
  precipitation  Float
  seedHash       String   @unique
  renderMode     String   @default("3d-sculpture") // "3d-sculpture" | "2d-flowfield"
  posterTheme    String   @default("obsidian")     // "obsidian" | "archival-white"
  likesCount     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([likesCount(sort: Desc)])
}
